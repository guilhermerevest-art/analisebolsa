# Copie para .env e preencha. Nunca use o banco de produção em desenvolvimento.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analisebolsa_dev
# Segredo HS256 com pelo menos 32 bytes (ex.: openssl rand -base64 48)
INTERNAL_JWT_SECRET=
API_INTERNAL_URL=http://localhost:8000
# Chave entre web e api (X-Internal-Key). Vazia no dev local; obrigatória em produção.
INTERNAL_API_KEY=
WEB_INTERNAL_URL=http://localhost:3000
# Segredo do Auth.js (ex.: openssl rand -base64 32) e URL pública do site
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Opcional. Sem token, a brapi fica só com catálogo e fundamentos.
BRAPI_TOKEN=
FONTES_COTACOES=yahoo,brapi
FONTES_PROVENTOS=brapi,yahoo
# E-mails que recebem role=admin no cadastro, separados por vírgula
ADMIN_EMAILS=

# URL pública do site (canonical, sitemap)
SITE_URL=http://localhost:3000
